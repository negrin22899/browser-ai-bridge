{
  "name": "browser-ai-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Local runtime bridging browser AI with developer tools via Tool Negotiation",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/tools/*",
    "examples/*",
    "!apps/desktop"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "setup": "node setup.js",
    "build": "npm run build -w @bab/protocol -w @bab/core -w @bab/runtime -w @bab/prompt-engine -w @bab/playwright-provider -w @bab/api-provider -w @bab/plugin-sdk -w @bab/mcp-adapter -w @bab/tools-fs -w @bab/tools-git -w @bab/tools-shell -w @bab/api -w @bab/cli -w @bab/dashboard -w @bab/plugin-example",
    "build:desktop": "cd apps/desktop && npm run build:win",
    "build:desktop:mac": "cd apps/desktop && npm run build:mac",
    "build:desktop:linux": "cd apps/desktop && npm run build:linux",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces",
    "clean": "npm run clean --workspaces --if-present && rm -rf packages/*/tsconfig.build.tsbuildinfo apps/*/tsconfig.build.tsbuildinfo examples/*/tsconfig.build.tsbuildinfo packages/tools/*/tsconfig.build.tsbuildinfo",
    "dashboard": "npm run dev -w @bab/dashboard",
    "start": "node scripts/start-dashboard.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "commander": "^15.0.0"
  }
}
