{
  "name": "@bab/cli",
  "version": "1.1.0",
  "description": "CLI for Browser AI Bridge - Use browser AI in your local environment",
  "main": "dist/index.js",
  "bin": {
    "bab": "dist/index.js",
    "browser-ai-bridge": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ai",
    "browser",
    "gemini",
    "chatgpt",
    "claude",
    "deepseek",
    "openai",
    "cli"
  ],
  "author": "Browser AI Bridge Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/negrin22899/browser-ai-bridge.git"
  },
  "homepage": "https://github.com/negrin22899/browser-ai-bridge",
  "bugs": {
    "url": "https://github.com/negrin22899/browser-ai-bridge/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@bab/api": "*",
    "@bab/core": "*",
    "@bab/protocol": "*",
    "@bab/prompt-engine": "*",
    "@bab/runtime": "*",
    "@bab/playwright-provider": "*",
    "@bab/plugin-sdk": "*",
    "@bab/tools-fs": "*",
    "@bab/tools-git": "*",
    "@bab/tools-shell": "*",
    "@hono/node-server": "^1.0.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.0.0",
    "@types/node": "^22.0.0"
  }
}
