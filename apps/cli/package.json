{
  "name": "@bab/cli",
  "version": "0.1.0",
  "description": "CLI for Browser AI Bridge",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "bab": "dist/index.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bab/api": "*",
    "@bab/core": "*",
    "@bab/protocol": "*",
    "@bab/prompt-engine": "*",
    "@bab/runtime": "*",
    "@bab/playwright-provider": "*",
    "@bab/tools-fs": "*",
    "@bab/tools-git": "*",
    "@bab/tools-shell": "*",
    "@hono/node-server": "^1.0.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.0.0",
    "@types/node": "^22.0.0"
  }
}
