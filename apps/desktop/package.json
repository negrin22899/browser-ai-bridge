{
  "name": "@bab/desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Desktop application for Browser AI Bridge",
  "author": "Browser AI Bridge Team",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "start": "npm run compile && electron .",
    "build": "npm run compile && electron-builder",
    "build:win": "npm run compile && electron-builder --win",
    "build:mac": "npm run compile && electron-builder --mac",
    "build:linux": "npm run compile && electron-builder --linux",
    "pack": "npm run compile && electron-builder --dir"
  },
  "dependencies": {
    "electron-store": "^8.0.0",
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.browseraibridge.desktop",
    "productName": "Browser AI Bridge",
    "publish": [
      {
        "provider": "github",
        "owner": "negrin22899",
        "repo": "browser-ai-bridge"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../apps/cli/dist",
        "to": "cli",
        "filter": ["**/*"]
      },
      {
        "from": "../../apps/dashboard/dist",
        "to": "dashboard",
        "filter": ["**/*"]
      },
      {
        "from": "../../packages",
        "to": "packages",
        "filter": ["**/dist/**/*"]
      },
      {
        "from": "../../node_modules",
        "to": "node_modules",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Browser AI Bridge"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Development"
    }
  }
}
